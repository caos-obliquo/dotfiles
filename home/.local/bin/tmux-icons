#!/bin/bash
# tmux status-right (unused): text-only BAT%/VOL%.
# status-right currently shows only tmux-music; kept for reference.

# Battery
BAT_PCT=""
BAT_COLOR="#6272a4"
BAT_PATH="/sys/class/power_supply/BAT0"
if [ -d "$BAT_PATH" ]; then
  BAT_PCT=$(cat "$BAT_PATH/capacity" 2>/dev/null || echo "?")
  STATUS=$(cat "$BAT_PATH/status" 2>/dev/null || echo "Unknown")
  case "$STATUS" in
    Charging) BAT_COLOR="#50fa7b" ;;
    Discharging)
      if [ "$BAT_PCT" -le 15 ]; then BAT_COLOR="#ff5555"
      elif [ "$BAT_PCT" -le 30 ]; then BAT_COLOR="#ffb86c"
      elif [ "$BAT_PCT" -le 50 ]; then BAT_COLOR="#f1fa8c"
      elif [ "$BAT_PCT" -le 80 ]; then BAT_COLOR="#50fa7b"
      else BAT_COLOR="#50fa7b"; fi
      ;;
    Full) BAT_COLOR="#50fa7b" ;;
    *) BAT_COLOR="#6272a4" ;;
  esac
fi

# Volume (PipeWire/WirePlumber via wpctl)
VOL_PCT=""
VOL_COLOR="#6272a4"
if command -v wpctl >/dev/null 2>&1; then
  VOL_OUT=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
  if [ -n "$VOL_OUT" ]; then
    VOL_PCT=$(echo "$VOL_OUT" | awk '{print int($2*100)}')
    if echo "$VOL_OUT" | grep -q "MUTED"; then VOL_COLOR="#ff5555"
    else VOL_COLOR="#50fa7b"; fi
  fi
fi

PARTS=()
[ -n "$BAT_PCT" ] && PARTS+=("#[fg=$BAT_COLOR]BAT $BAT_PCT%")
[ -n "$VOL_PCT" ] && PARTS+=("#[fg=$VOL_COLOR]VOL $VOL_PCT%")

SEP="#[fg=#6272a4]  "
printf "%s" "${PARTS[0]}"
for p in "${PARTS[@]:1}"; do
  printf "%s%s" "$SEP" "$p"
done
