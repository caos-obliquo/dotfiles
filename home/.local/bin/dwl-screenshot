#!/bin/bash
# DWL screenshot for Wayland with clipboard support

case "$1" in
    full)
        grim - | tee ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png | magick - -resize '1280x>' - | kapc copy -t image/png
        notify-send "Screenshot" "Full screen saved to history" 2>/dev/null || true
        ;;
    area)
        grim -g "$(slurp)" - | tee ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png | magick - -resize '1280x>' - | kapc copy -t image/png
        notify-send "Screenshot" "Area saved to history" 2>/dev/null || true
        ;;
    window)
        grim -g "$(slurp -d)" - | tee ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png | magick - -resize '1280x>' - | kapc copy -t image/png
        notify-send "Screenshot" "Window saved to history" 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {full|area|window}"
        exit 1
        ;;
esac
