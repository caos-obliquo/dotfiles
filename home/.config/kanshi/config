# kanshi - automatic output configuration (Wayland, autorandr-style)

# Applied automatically when an output matches. Talk to dwl via the
# wlr-output-management protocol. Requires: sudo pacman -S kanshi
# (launch kanshi from start-dwl.sh)

profile laptop {
    output eDP-1 mode 1920x1200@60.001Hz position 0,0 scale 1
}

# External monitor (docked). Adjust the output name/mode to your hardware:
#   wlr-randr   # list connected outputs
